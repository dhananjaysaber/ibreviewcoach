# Existing project values only. Never use a Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_EXISTING_PUBLIC_ANON_KEY

# Optional staging-only: enable verified section audits AFTER installing
# supabase/migrations and deploying workshop-audit to an isolated test project.
VITE_ENABLE_WORKSHOP_AUDIT=false

# REAL end-to-end LOCAL testing (server-side secret; never prefix with VITE_)
# Enter your own Anthropic API key. It is never embedded in the browser bundle.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
LOCAL_LAB_MODEL=claude-sonnet-4-6
