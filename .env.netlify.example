# Netlify Site configuration > Environment variables (NOT a file to deploy)
# Set the REAL values in Netlify's UI. Only public keys with VITE_ prefix.
VITE_SUPABASE_URL=https://YOUR-IA-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_KEY
VITE_ENABLE_WORKSHOP_AUDIT=false
# Add new website origin to Supabase Auth redirect allow-list as needed.
# Never set ANTHROPIC_API_KEY or SUPABASE_SERVICE_ROLE_KEY in browser variables.
